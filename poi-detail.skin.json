{
  "_version": "1.0",
  "_component": "POIDetail",
  "_description": "Fantasy commander game — Dark Luxury aesthetic, Blizzard old-school physical object approach",

  "palette": {
    "body_base":          "#0c0a08",
    "body_note":          "nero caldo — opposto di temperatura al rack",
    "rack_base":          "#1e2d48",
    "rack_note":          "blu mezzanotte — stacca per luminosità e temperatura",
    "bronze_mid":         "#3a2008",
    "bronze_light":       "rgba(255,252,210,.80)",
    "bronze_dark":        "rgba(0,0,0,.96)",
    "bronze_left":        "rgba(210,158,38,.40)",
    "bronze_right":       "rgba(8,4,0,.80)",
    "title_color":        "#ffd84a",
    "title_note":         "Diablo III gold — luminoso, leggibile, dominante",
    "stat_value":         "#e8b040",
    "danger_value":       "#e04818",
    "subtitle":           "rgba(192,158,78,.55)",
    "label":              "rgba(168,128,52,.62)",
    "description":        "rgba(200,168,105,.58)",
    "rack_highlight_top": "rgba(148,172,220,.20)",
    "rack_vignette":      "rgba(8,12,24,.42)",
    "ornament_gem":       "rgba(192,140,34,.48)",
    "ornament_line":      "rgba(175,125,30,.20)",
    "table_veil":         "rgba(4,3,2,.45)"
