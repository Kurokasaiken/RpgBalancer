      "inner.ring.stop1": { "value": "#c88430", "label": "Anello interno — ambra" },
      "inner.ring.stop2": { "value": "#7c3e10", "label": "Anello interno — bronzo" },
      "inner.ring.stop3": { "value": "#3c1c04", "label": "Anello interno — scuro" },
      "inner.ring.stop4": { "value": "#160a02", "label": "Anello interno — SE" },
