      "outer.fill.stop1": { "value": "#e4b048", "label": "Bronzo esterno — oro caldo" },
      "outer.fill.stop2": { "value": "#a05c18", "label": "Bronzo esterno — bronzo medio" },
      "outer.fill.stop3": { "value": "#602c08", "label": "Bronzo esterno — bronzo scuro" },
      "outer.fill.stop4": { "value": "#341604", "label": "Bronzo esterno — marrone profondo" },
      "outer.fill.stop5": { "value": "#0e0602", "label": "Bronzo esterno — SE quasi nero" },
      "outer.shine.stop0": { "value": "rgba(255,240,165,.28)", "label": "Shine NW medaglione" },
      "outer.shine.stop1": { "value": "rgba(255,225,135,.08)", "label": "Shine fade" },
      "outer.shine.stop2": { "value": "rgba(0,0,0,.55)",       "label": "Ombra SE medaglione" },
