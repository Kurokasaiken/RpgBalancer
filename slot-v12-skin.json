    "R_CAV": 58,
    "R_RING1": 53,
    "R_RING2": 47,
    "R_SEAL": 22,
    "R_ARC": 51,
    "R_BZ_IN": 62,
    "R_BZ_OUT": 73,
    "R_MED_OUT": 42,
    "R_MED_RING": 34,
    "R_MED_FLD": 30,
    "R_MED_POR": 27,
    "TOOTH_HEIGHT": 14,
    "TOOTH_WIDTH": 7.5
  },

