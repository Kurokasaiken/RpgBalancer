{
  "id": "slot-wilderness-bronze",
  "name": "Wilderness · Bronzo Selvatico",
  "version": "1.0.0",
  "author": "skin-devtools",
  "quality": "AAA",
  "targetVersion": "slot@v12",
  "compatibility": ["SlotComponent", "ResidentSlotRack"],

  "geometry": {
