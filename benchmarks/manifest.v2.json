{
  "version": 2,
  "name": "model-arena",
  "description": "PLAN-041 / R-204 model arena: same 3 cases, contract approach fixed, one lane per free model. Measures per-model solve time + correctness to build the dispatch ladder and parallelization plan.",
  "defaults": {
    "repeats": 1,
    "approaches": ["contract"],
    "worktreeRoot": "tmp/bench-worktrees",
    "resultsDir": "test-results/bench-replay",
    "model": "openai/gpt-oss-120b",
    "models": [
      { "provider": "gemini", "model": "gemini-3.8-flash" },
      { "provider": "groq", "model": "openai/gpt-oss-120b" },
      { "provider": "groq", "model": "qwen/qwen3.8-27b" },
      { "provider": "cerebras", "model": "gpt-oss-120b" },
      { "provider": "openrouter", "model": "nvidia/nemotron-3-super-120b-a12b:free" },
      { "provider": "mistral", "model": "mistral-small-latest" }
    ],
    "maxIterations": 48,
    "taskTimeoutMs": 1800000,
    "installTimeoutMs": 420000,
    "verifyTimeoutMs": 300000
  },
  "cases": [
    {
      "id": "B1-i18n-icu",
