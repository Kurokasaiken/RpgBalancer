{
  "name": "progetti-personali",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "start": "vite --mode development",
    "build": "vite build",
    "build:deploy": "vite build --mode production",
    "build:minimal": "vite build --mode production",
    "build:playwright": "vite build --mode playwright",
    "lint": "eslint",
    "component-lab:deps": "tsx scripts/idleVillage/componentLabDependencyMap.ts --components=night_threat,expedition_list,combat_replay",
    "component-lab:promote": "tsx scripts/idleVillage/minimalPromotionGuard.ts",
    "safeguards:quick": "npm run lint -- --max-warnings=55 --ignore-pattern src/ui/styleLab/physics --ignore-pattern src/ui/styleLab/physicsLab && npm run test:unit -- tests/unit/idleVillage/MinimalGameplayPage.test.tsx",
    "lint:staged": "lint-staged",
    "docs:audit": "tsx scripts/docs/docsAudit.ts",
    "lint:fix": "eslint --fix",
    "safeguard": "npm run build && npm run lint && npm run test:unit && npm run kanban:lint",
    "agent:complete": "node scripts/agentComplete.js",
    "file:lock": "node scripts/fileLock.js lock",
    "file:unlock": "node scripts/fileLock.js unlock",
    "file:status": "node scripts/fileLock.js status",
    "file:cleanup": "node scripts/fileLock.js cleanup",
    "playtest:log": "tsx scripts/mobilePlaytestLogger.ts",
    "playtest:log:interactive": "tsx scripts/mobilePlaytestLogger.ts --interactive",
    "playtest:replay": "tsx scripts/mobilePlaytestLogger.ts --replay",
    "playtest:replay:interactive": "tsx scripts/mobilePlaytestLogger.ts --replay --interactive",
    "playtest:post-playwright": "tsx scripts/mobilePlaytestLogger.ts --post-playwright",
    "playtest:post-playwright:markdown": "tsx scripts/mobilePlaytestLogger.ts --post-playwright --aggregate-format=markdown",
    "playtest:post-playwright:csv": "tsx scripts/mobilePlaytestLogger.ts --post-playwright --aggregate-format=csv",
    "test:mobile:logger": "playwright test tests/mobile-logger-e2e.spec.ts --reporter=list",
    "test:mobile:report": "npm run test:mobile:logger && npm run playtest:post-playwright",
    "build:check": "tsx scripts/build-check.ts",
    "devops:boot-guard": "tsx scripts/devtools/multiAppBootGuard.ts",
    "safeguard:full": "npm run test && npm run build:check && npm run kanban:lint",
    "preview": "vite preview",
    "sync:playwright-trace-assets": "tsx scripts/playwright/syncTraceAssets.ts",
    "preview:playwright": "npm run sync:playwright-trace-assets && npm run build:playwright && vite preview --mode playwright --host 127.0.0.1 --port 5179 --strictPort",
    "deploy:vercel:verify": "tsx scripts/deploy/mobileVerify.ts",
    "test": "NODE_OPTIONS=--require=./polyfill-crypto.cjs vitest run --passWithNoTests",
    "test:watch:dev": "NODE_OPTIONS=--require=./polyfill-crypto.cjs vitest --watch",
    "test:unit": "NODE_OPTIONS=--require=./polyfill-crypto.cjs vitest run --passWithNoTests",
    "test:interactive:roster": "VITEST_INCLUDE=tests/unit/testRosterPage/TestRosterPage.integration.test.tsx NODE_OPTIONS=--require=./polyfill-crypto.cjs vitest run",
    "test:test-roster": "npm run test:test-roster:unit && npm run test:test-roster:e2e",
    "test:test-roster:unit": "VITEST_INCLUDE=tests/unit/testRosterPage/TestRosterPage.integration.test.tsx,tests/unit/testRosterPage/TestRosterPage.rtl.test.tsx NODE_OPTIONS=--require=./polyfill-crypto.cjs vitest run",
    "test:test-roster:e2e": "playwright test tests/e2e/idleVillage/testRosterPgCards.spec.ts tests/e2e/idleVillage/workerPanelTestRoute.spec.ts tests/e2e/idleVillage/test-route-drag-offset.spec.ts tests/e2e/idleVillage/drag-drop-master-suite.spec.ts tests/e2e/idleVillage/drag-drop-comprehensive-test.spec.ts tests/e2e/idleVillage/drag-drop-final-test.spec.ts tests/e2e/idleVillage/drag-drop-functionality-test.spec.ts tests/e2e/idleVillage/drag-drop-self-contained-test.spec.ts tests/e2e/idleVillage/drag-drop-with-data-test.spec.ts tests/e2e/idleVillage/drag-drop-with-storage.spec.ts tests/e2e/idleVillage/interactive-drag-test.spec.ts tests/e2e/idleVillage/simple-debug-test.spec.ts",
    "test:diagnostics": "NODE_OPTIONS=--require=./polyfill-crypto.cjs vitest run tests/utils/sandboxDiagnostics.test.tsx",
    "test:persistence": "NODE_OPTIONS=--require=./polyfill-crypto.cjs vitest run tests/persistence/",
    "audit:persistence": "tsx scripts/audits/persistenceAudit.ts",
    "audit:character-snapshot": "node --import tsx/esm -e \"import('./scripts/idleVillage/characterManagerSnapshotInspector.ts').then(m => new m.CharacterSnapshotInspector({ verbose: true, validateStructure: true, checkDuplicates: true, checkIntegrity: true }).inspect().then(r => process.exit(r.summary.healthy ? 0 : 1)).catch(e => { console.error(e); process.exit(1); }))\"",
    "audit:roster-transformation": "node --import tsx/esm -e \"import('./scripts/idleVillage/rosterTransformationDiffViewer.ts').then(m => new m.RosterTransformationDiffViewer({ verbose: true, compareStats: true, compareAssignments: true, compareMetadata: true }).generateDiff('data/characters-before.json', 'data/characters.json').then(r => process.exit(r.impact.overallSeverity === 'critical' ? 1 : 0)).catch(e => { console.error(e); process.exit(1); }))\"",
    "stress-report": "tsx scripts/balancer/stressReportGenerator.ts",
    "prompt-conflict-detector": "tsx scripts/coordinator/promptConflictDetector.ts",
    "test:lint": "npm run lint",
    "test:all": "npm run test:lint && npm run test:unit && npm run test:e2e",
    "test:all:quick": "npm run test:lint && npm run test:unit",
    "test:roster:unified": "npm run lint -- src/ui/idleVillage/TestRosterPage.tsx src/ui/idleVillage/components/DragTestContainer.tsx && npm run test:unit -- tests/unit/idleVillage/ && npm run test:e2e -- tests/e2e/idleVillage/testRosterPgCards.spec.ts && tsx scripts/idleVillage/dragDiagnostics.ts --preset quick --output test-results",
    "asset-downloader": "tsx scripts/physicsLab/assetDownloader.ts",
    "test:e2e": "playwright test --reporter=list",
    "test:e2e:ui:dev": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:sandbox-reset": "playwright test tests/villageSandbox-reset.spec.ts --project=\"Desktop Chrome\" --trace on",
    "test:visual": "playwright test --grep @visual --project=\"Visual Regression\"",
    "test:visual:update": "playwright test --grep @visual --project=\"Visual Regression\" --update-snapshots",
    "test:visual:docker": "docker run --rm -v ${PWD}:/app visual-tests",
    "test:visual:docker:update": "docker run --rm -v ${PWD}:/app visual-tests --update-snapshots",
    "visual:build-docker": "docker build -t visual-tests -f Dockerfile.visual-tests .",
    "visual:minimal-gameplay": "tsx scripts/visual/minimalGameplayBaselineRunner.ts",
    "minimal:e2e": "playwright test tests/e2e/idleVillage/minimalWireframe.smoke.spec.ts --project=\"Desktop Chrome\"",
    "test:physical": "playwright test --grep @physical",
    "check:sandbox-docs": "npm run lint && npm run test -- src/ui/idleVillage/map && npx playwright test tests/villageSandbox-layout.spec.ts --workers=1 && npx playwright test tests/villageSandbox-roster.spec.ts --workers=1 && tsx scripts/check_sandbox_docs.ts",
    "lint:docs": "markdownlint src/docs/**/*.md",
    "storage:test:balancer": "npm run test:unit -- tests/unit/storage/BalancerConfigStore.storage.test.ts",
    "kanban:lint": "tsx scripts/kanbanLint.ts",
    "prompt:check": "tsx scripts/checkPromptLock.ts",
    "buffer:refresh": "tsx scripts/coordinator/promptQuickBuffer.ts",
    "guardian:test": "NODE_OPTIONS=--require=./polyfill-crypto.cjs vitest run -c vitest.guardian.config.ts",
    "guardian:health-check": "tsx scripts/guardian/deploymentHealthCheck.ts",
    "guardian:deploy-guard": "tsx scripts/guardian/vercelDeploymentGuard.ts",
    "guardian:setup-wanderlust": "cd 'wanderlust triumph' && node ./scripts/guardian.setup-wanderlust.mjs",
    "stress:export": "tsx scripts/stressTesting/exportStressReport.ts",
    "stressTesting:run": "node --loader ts-node/esm scripts/stressTesting/runStressPipeline.ts run",
    "stressTesting:checkData": "tsx scripts/stressTesting/checkDataQuality.ts",
    "stress:api:server": "tsx scripts/api/stressTestingServer.ts",
    "stress:api:start": "concurrently \"npm run stress:api:server\" \"npm run dev\"",
    "wanderlust:dev": "cd 'wanderlust triumph' && npm run dev:minimal",
    "wanderlust:test": "cd 'wanderlust triumph' && npm run test:minimal",
    "wanderlust:open-root": "cd 'wanderlust triumph' && npm run open:root",
    "file:lock:cli": "tsx scripts/fileLockCLI.ts lock",
    "file:unlock:cli": "tsx scripts/fileLockCLI.ts unlock",
    "file:audit": "tsx scripts/fileLockCLI.ts audit",
    "time-tracker": "tsx scripts/timeTracker.ts",
    "time-reporter": "tsx scripts/timeReporter.ts",
    "ci:monitor": "tsx scripts/coord/ci-regression-monitor.ts --monitor",
    "ci:monitor:trends": "tsx scripts/coord/ci-regression-monitor.ts --analyze",
    "ci:monitor:report": "tsx scripts/coord/ci-regression-monitor.ts --report",
    "ci:monitor:alerts": "tsx scripts/coord/ci-regression-monitor.ts --alerts",
    "ci:monitor:cleanup": "tsx scripts/coord/ci-regression-monitor.ts --cleanup",
    "ci:monitor:guard": "tsx scripts/coord/ci-regression-monitor.ts --monitor --alerts",
    "ci:regression-monitor": "tsx scripts/coord/ci-regression-monitor.ts",
    "sts:benchmark": "tsx scripts/stsTelemetry/benchmarkSimulator.ts",
    "sts:benchmark:quick": "tsx scripts/stsTelemetry/benchmarkSimulator.ts --iterations 50 --turns 10",
    "sts:benchmark:standard": "tsx scripts/stsTelemetry/benchmarkSimulator.ts --iterations 100 --turns 25",
    "sts:benchmark:stress": "tsx scripts/stsTelemetry/benchmarkSimulator.ts --iterations 500 --turns 100",
    "sts:seed-matrix": "tsx scripts/sts/seedMatrix.ts",
    "sts:matrix": "tsx scripts/ci/stsMatrixRunner.ts",
    "sts:export:combat-config": "tsx scripts/sts/exportCombatantConfig.ts export",
    "sts:validate:combat-config": "tsx scripts/sts/exportCombatantConfig.ts validate",
    "sts:diff:combat-config": "tsx scripts/sts/exportCombatantConfig.ts diff",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook --config-dir .storybook",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "calibrate": "npx tsx src/balancing/simulation/cli.ts",
    "balance": "npx tsx src/balancing/archetype/CLI.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/postcss": "^4.1.17",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-fs": "^2.4.4",
    "@testing-library/dom": "^10.4.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/lodash.merge": "^4.6.9",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "express": "^5.2.1",
    "framer-motion": "^12.4.7",
    "lodash.merge": "^4.6.2",
    "lucide-react": "^0.555.0",
    "pako": "^2.1.0",
    "pixi.js": "^8.14.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-error-boundary": "^6.0.3",
    "react-is": "^19.2.0",
    "recharts": "^3.5.1",
    "simple-statistics": "^7.8.8",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.17",
    "zod": "^4.1.13",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@storybook/addon-a11y": "10.2.10",
    "@storybook/addon-docs": "10.2.10",
    "@storybook/react-vite": "10.2.10",
    "@tauri-apps/cli": "^2.9.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser-playwright": "^4.0.12",
    "@vitest/coverage-v8": "^4.0.12",
    "autoprefixer": "^10.4.22",
    "axe-core": "^4.11.1",
    "axe-playwright": "^2.2.2",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "10.2.10",
    "globals": "^16.5.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^24.0.0",
    "lint-staged": "^15.2.10",
    "markdownlint-cli": "^0.47.0",
    "node-fetch": "^3.3.2",
    "ora": "^9.0.0",
    "playwright": "^1.57.0",
    "postcss": "^8.5.6",
    "puppeteer": "^24.37.5",
    "storybook": "10.2.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.14",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vercel": "^39.1.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.12"
  },
  "lint-staged": {
    "src/ui/idleVillage/**/*.{ts,tsx}": "npx eslint --cache --fix --max-warnings=55",
    "src/engine/game/idleVillage/**/*.{ts,tsx}": "npx eslint --cache --fix --max-warnings=55",
    "src/ui/styleLab/!(physics|physicsLab)/**/*.{ts,tsx}": "npx eslint --cache --fix --max-warnings=55"
  }
}
