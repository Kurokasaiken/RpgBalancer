import React, { useState } from 'react';
import { WanderlustSurface } from '@/ui/wanderlust-surface';

/**
 * MinimalMarketActionCardPage
 *
 * Isolated test page for MarketActionCard component.
 * Shows market item card for trading/purchasing.
 *
 * Route: /minimal-market
 * Spec: src/docs/docs/minimal_slice/11_market.md
 */

interface MarketItem {
  id: string;
  name: string;
  icon: string;
  description: string;
  cost: number;
  stock: number;
  rarity: 'common' | 'rare' | 'epic';
}

const mockItems: MarketItem[] = [
  {
    id: 'item_001',
    name: 'Health Potion',
    icon: '🧪',
    description: 'Restores 50 HP',
    cost: 50,
    stock: 10,
    rarity: 'common',
  },
  {
    id: 'item_002',
    name: 'Mana Potion',
    icon: '💎',
    description: 'Restores 30 Mana',
    cost: 75,
    stock: 0,
    rarity: 'common',
  },
  {
    id: 'item_003',
    name: 'Legendary Sword',
    icon: '⚔️',
    description: '+10 STR, +5 DEX',
    cost: 500,
    stock: 2,
    rarity: 'epic',
  },
];

export default function MinimalMarketActionCardPage() {
  const [items, setItems] = useState(mockItems);
  const [selectedItemIdx, setSelectedItemIdx] = useState(0);
  const [hoveredItemIdx, setHoveredItemIdx] = useState<number | null>(null);
  const [purchases, setPurchases] = useState<string[]>([]);

  const currentItem = items[selectedItemIdx];

  const getRarityColor = (rarity: 'common' | 'rare' | 'epic'): string => {
    if (rarity === 'common') return '#666';
    if (rarity === 'rare') return '#4169e1';
    return '#ffd700';
  };

  const getRarityLabel = (rarity: 'common' | 'rare' | 'epic'): string => {
    return rarity.charAt(0).toUpperCase() + rarity.slice(1);
  };

  const handlePurchase = (idx: number) => {
    const item = items[idx];
    if (item.stock > 0) {
      setPurchases([...purchases, item.id]);
      const newItems = [...items];
      newItems[idx] = { ...item, stock: item.stock - 1 };
      setItems(newItems);
    }
  };

  return (
    <div style={styles.container}>
      <h1 style={styles.title}>MarketActionCard Isolated Test</h1>
      <p style={styles.subtitle}>Route: /minimal-market | Spec: src/docs/docs/minimal_slice/11_market.md</p>

      <div style={styles.contentArea}>
        <WanderlustSurface
          shape="panel"
          material="bronze"
          interactive={false}
          style={{ flex: 2, minHeight: '400px' }}
        >
          <div style={styles.itemsGrid} data-testid="market-items-grid">
          {items.map((item, idx) => (
            <div
              key={item.id}
              style={{
                ...styles.itemCard,
                borderColor: selectedItemIdx === idx ? '#4caf50' : '#ddd',
                opacity: item.stock === 0 ? 0.5 : 1,
              }}
              data-testid={`market-item-${idx}`}
              data-item-id={item.id}
              data-stock={item.stock}
              onClick={() => setSelectedItemIdx(idx)}
              onMouseEnter={() => setHoveredItemIdx(idx)}
              onMouseLeave={() => setHoveredItemIdx(null)}
            >
              <div style={styles.itemIcon} data-testid={`market-icon-${idx}`}>
                {item.icon}
              </div>
              <h4 style={styles.itemName} data-testid={`market-name-${idx}`}>
                {item.name}
              </h4>
              <div
                style={{
                  ...styles.rarityBadge,
                  backgroundColor: getRarityColor(item.rarity),
                }}
                data-testid={`market-rarity-${idx}`}
              >
                {getRarityLabel(item.rarity)}
              </div>
              <div style={styles.price} data-testid={`market-price-${idx}`}>
                {item.cost} Gold
              </div>
              <div
                style={{
                  ...styles.stock,
                  color: item.stock === 0 ? '#f44336' : '#4caf50',
                }}
                data-testid={`market-stock-${idx}`}
              >
                {item.stock === 0 ? 'Sold Out' : `Stock: ${item.stock}`}
              </div>

              <button
                onClick={(e) => {
                  e.stopPropagation();
                  handlePurchase(idx);
                }}
                disabled={item.stock === 0}
                style={{
                  ...styles.buyButton,
                  backgroundColor: item.stock === 0 ? '#ccc' : '#4caf50',
                  cursor: item.stock === 0 ? 'not-allowed' : 'pointer',
                }}
                data-testid={`market-buy-${idx}`}
              >
                {item.stock === 0 ? 'Sold Out' : 'Buy'}
              </button>

              {hoveredItemIdx === idx && (
                <div style={styles.tooltip} data-testid={`market-tooltip-${idx}`}>
                  <strong>{item.name}</strong>
                  <div>{item.description}</div>
                  <div style={{ marginTop: '0.5rem', fontSize: '0.8rem' }}>Cost: {item.cost} Gold</div>
                </div>
              )}
            </div>
          ))}
        </div>
        </WanderlustSurface>

        <WanderlustSurface
          shape="card"
          material="bronze"
          interactive={false}
          style={{ flex: 1, minHeight: '400px' }}
        >
          <div style={styles.detailsPanel}>
          <h2>Item Details</h2>
          <div style={styles.detailsContent} data-testid="market-details">
            <div style={styles.detailsIcon}>{currentItem.icon}</div>
            <h3 style={styles.detailsName} data-testid="market-details-name">
              {currentItem.name}
            </h3>
            <p style={styles.detailsDescription} data-testid="market-details-desc">
              {currentItem.description}
            </p>

            <div style={styles.detailsRow}>
              <strong>Price:</strong> {currentItem.cost} Gold
            </div>
            <div style={styles.detailsRow}>
              <strong>Rarity:</strong> {getRarityLabel(currentItem.rarity)}
            </div>
            <div style={styles.detailsRow}>
              <strong>Stock:</strong> {currentItem.stock > 0 ? `${currentItem.stock} available` : 'Sold Out'}
            </div>

            <button
              onClick={() => handlePurchase(selectedItemIdx)}
              disabled={currentItem.stock === 0}
              style={{
                ...styles.detailsBuyButton,
                backgroundColor: currentItem.stock === 0 ? '#ccc' : '#4caf50',
                cursor: currentItem.stock === 0 ? 'not-allowed' : 'pointer',
              }}
              data-testid="market-details-buy"
            >
              {currentItem.stock === 0 ? 'Sold Out' : 'Purchase Item'}
            </button>
          </div>

          {purchases.length > 0 && (
            <div style={styles.purchaseHistory} data-testid="market-purchases">
              <h3>Purchases ({purchases.length})</h3>
              <ul style={styles.purchaseList}>
                {purchases.map((itemId, idx) => {
                  const item = items.find((i) => i.id === itemId);
                  return (
                    <li key={idx} data-testid={`market-purchase-${idx}`}>
                      {item?.name}
                    </li>
                  );
                })}
              </ul>
            </div>
          )}
        </div>
        </WanderlustSurface>

        <WanderlustSurface
          shape="panel"
          material="bronze"
          interactive={false}
          style={styles.testInfo}
        >
          <div style={{ padding: '2rem' }}>
            <h2>Test Information</h2>
            <ul>
              <li>
                <strong>Component:</strong> MarketActionCard
              </li>
              <li>
                <strong>Test Cases:</strong> 20 (rendering, display, interactions, state, edge cases)
              </li>
              <li>
                <strong>Test File:</strong> tests/e2e/minimal_slice_11_market.spec.ts
              </li>
              <li>
                <strong>Items:</strong> 3 (Health Potion, Mana Potion, Legendary Sword)
              </li>
            </ul>
          </div>
        </WanderlustSurface>
      </div>
    </div>
  );
}

const styles = {
  container: {
    padding: '2rem',
    maxWidth: '1200px',
    margin: '0 auto',
    fontFamily: 'system-ui, -apple-system, sans-serif',
    backgroundColor: '#1a1d23',
    minHeight: '100vh',
    color: '#fff',
  } as React.CSSProperties,
  title: {
    fontSize: '2rem',
    marginBottom: '0.5rem',
    color: '#e2e8f0',
  } as React.CSSProperties,
  subtitle: {
    color: '#94a3b8',
    marginBottom: '2rem',
    fontSize: '0.9rem',
  } as React.CSSProperties,
  contentArea: {
    display: 'flex',
    gap: '2rem',
    marginBottom: '2rem',
  } as React.CSSProperties,
  itemsGrid: {
    flex: 2,
    display: 'grid',
    gridTemplateColumns: 'repeat(auto-fill, minmax(180px, 1fr))',
    gap: '1rem',
    backgroundColor: 'rgba(30, 41, 59, 0.5)',
    padding: '1.5rem',
    borderRadius: '8px',
  } as React.CSSProperties,
  itemCard: {
    padding: '1rem',
    borderRadius: '8px',
    border: '2px solid #475569',
    backgroundColor: 'rgba(30, 41, 59, 0.8)',
    cursor: 'pointer',
    transition: 'all 0.2s',
    textAlign: 'center',
    position: 'relative',
  } as React.CSSProperties,
  itemIcon: {
    fontSize: '2.5rem',
    marginBottom: '0.5rem',
  } as React.CSSProperties,
  itemName: {
    margin: '0.5rem 0',
    fontSize: '0.95rem',
    color: '#e2e8f0',
  } as React.CSSProperties,
  rarityBadge: {
    display: 'inline-block',
    padding: '0.25rem 0.5rem',
    borderRadius: '4px',
    color: '#fff',
    fontSize: '0.7rem',
    fontWeight: 'bold',
    marginBottom: '0.5rem',
  } as React.CSSProperties,
  price: {
    fontWeight: 'bold',
    fontSize: '0.9rem',
    color: '#f4a460',
    marginBottom: '0.25rem',
  } as React.CSSProperties,
  stock: {
    fontSize: '0.8rem',
    marginBottom: '0.75rem',
  } as React.CSSProperties,
  buyButton: {
    padding: '0.5rem 1rem',
    border: 'none',
    borderRadius: '4px',
    color: '#fff',
    fontWeight: 'bold',
    fontSize: '0.85rem',
    transition: 'background-color 0.2s',
  } as React.CSSProperties,
  tooltip: {
    position: 'absolute',
    bottom: '-80px',
    left: '50%',
    transform: 'translateX(-50%)',
    backgroundColor: '#1e293b',
    color: '#e2e8f0',
    padding: '0.75rem',
    borderRadius: '4px',
    fontSize: '0.8rem',
    zIndex: 10,
    whiteSpace: 'nowrap',
    border: '1px solid #475569',
  } as React.CSSProperties,
  detailsPanel: {
    flex: 1,
    backgroundColor: 'rgba(30, 41, 59, 0.5)',
    padding: '2rem',
    borderRadius: '8px',
  } as React.CSSProperties,
  detailsContent: {
    textAlign: 'center',
  } as React.CSSProperties,
  detailsIcon: {
    fontSize: '3rem',
    marginBottom: '1rem',
  } as React.CSSProperties,
  detailsName: {
    margin: '0.5rem 0',
    fontSize: '1.25rem',
    color: '#e2e8f0',
  } as React.CSSProperties,
  detailsDescription: {
    color: '#94a3b8',
    marginBottom: '1rem',
    fontSize: '0.95rem',
  } as React.CSSProperties,
  detailsRow: {
    padding: '0.75rem 0',
    borderBottom: '1px solid #475569',
    textAlign: 'left',
    fontSize: '0.9rem',
    color: '#e2e8f0',
  } as React.CSSProperties,
  detailsBuyButton: {
    marginTop: '1.5rem',
    padding: '0.75rem 1.5rem',
    border: 'none',
    borderRadius: '4px',
    color: '#fff',
    fontWeight: 'bold',
    transition: 'background-color 0.2s',
  } as React.CSSProperties,
  purchaseHistory: {
    marginTop: '2rem',
    padding: '1rem',
    backgroundColor: 'rgba(30, 41, 59, 0.8)',
    borderRadius: '4px',
    border: '1px solid #475569',
  } as React.CSSProperties,
  purchaseList: {
    listStyle: 'none',
    padding: 0,
    margin: '0.5rem 0 0 0',
    color: '#e2e8f0',
  } as React.CSSProperties,
  testInfo: {
    backgroundColor: 'rgba(30, 41, 59, 0.5)',
    padding: '2rem',
    borderRadius: '8px',
    border: '1px solid #475569',
  } as React.CSSProperties,
};
