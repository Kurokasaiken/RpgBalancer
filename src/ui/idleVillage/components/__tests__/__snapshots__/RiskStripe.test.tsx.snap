// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`RiskStripe > matches snapshot 1`] = `
<div
  aria-label="Injury risk: 25%, Death risk: 5%"
  class="risk-stripe"
  role="img"
  style="position: relative; height: 100%; width: 8px; background-color: var(--panel-border, rgba(255, 255, 255, 0.08)); border-radius: 4px;"
>
  <div
    style="position: absolute; bottom: 0px; left: 0px; right: 0px; height: 25%; background-color: var(--risk-injury, #fbbf24); border-radius: 0 0 4px 4px; transition: height 300ms ease;"
  />
  <div
    style="position: absolute; bottom: 25%; left: 0px; right: 0px; height: 5%; background-color: var(--risk-death, #dc2626); border-radius: 4px 4px 0 0; transition: height 300ms ease, bottom 300ms ease;"
  />
</div>
`;
