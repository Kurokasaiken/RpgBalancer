# Physical E2E Testing System - Visual Regression Docker Image
# Foundation for consistent visual testing across environments
# 
# @since 2026-01-23
# @author Guardian-VRT

FROM node:20.19.6-slim

# Install system dependencies for Playwright browsers and font consistency
RUN apt-get update && apt-get install -y \
    wget \
    gnupg \
    ca-certificates \
    procps \
    libnss3-dev \
    libatk-bridge2.0-0 \
    libdrm2 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libgbm1 \
    libxss1 \
    libasound2 \
    libatspi2.0-0 \
    libgtk-3-0 \
    libgdk-pixbuf2.0-0 \
    fonts-liberation \
    fonts-noto-color-emoji \
    fonts-dejavu-core \
    fonts-noto-cjk \
    fonts-wqy-zenhei \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package files
COPY package.json package-lock.json ./

# Install dependencies
RUN npm ci

# Copy project files
COPY . .

# Install Playwright browsers with dependencies
RUN npx playwright install --with-deps chromium firefox webkit

# Create directories for visual testing
RUN mkdir -p tests/visual/baselines \
    && mkdir -p test-results/visual \
    && mkdir -p test-results/screenshots

# Set environment variables for consistent rendering
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENV NODE_ENV=test
ENV CI=true

# Add user for non-root execution (required by Playwright)
RUN useradd -m -u 1001 playwright && \
    chown -R playwright:playwright /app
USER playwright

# Expose port for potential VNC debugging
EXPOSE 5900

# Default command - run visual tests
CMD ["npm", "run", "test:visual"]

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD npx playwright --version || exit 1
